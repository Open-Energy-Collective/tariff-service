        "measurement_explanation": null,
        "measurement_method": "monthly_peak",
        "rate_unit": "$/kW/month",
        "seasonal_applicability": "Applies in months: [1, 2, 3, 12]",
        "source_url": "https://www.ausnetservices.com.au/electricity/tariffs-and-charges/network-tariffs",
        "window": "15:00 to 21:00 (local time)"
      },
      {
        "calculation_example": "Example (Ausgrid EA116, Residential Demand):\n• Your highest 30-min demand this month (3pm-9pm, high season) was 5.2 kW\n• Demand rate: $11.85/kW/month\n• Monthly demand charge: 5.2 kW × $11.85 = $61.59\n• Outside high season (Apr/May/Sep/Oct), no demand charge applies\n• This is in addition to your energy charges ($/kWh) and daily supply charge",
        "days": "All days (including weekends)",
        "dnsp_code": "ausgrid",
